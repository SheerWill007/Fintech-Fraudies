# ---------------------------------------------------------------- Backend (FastAPI, backend/)
# Every variable is optional for local development.
# sample dataset, uploads/ and runtime/ (reviews, live transactions)
# FF_DATA_DIR=backend/data
# persisted model.joblib
# FF_MODEL_DIR=backend/models
FF_CORS_ORIGINS=http://localhost:3000
# FF_CORS_ORIGIN_REGEX=https://fraudies-.*\.vercel\.app   # allow Vercel preview deployments
FF_MAX_UPLOAD_MB=100
FF_CV_FOLDS=5
FF_TUNING_ITERATIONS=12
FF_REVIEW_BACKLOG_DAYS=10

# ---------------------------------------------------------------- Frontend (Next.js, frontend/)
# Dev server proxies /api/* here:
# API_URL=http://127.0.0.1:8000
# Production (Vercel): absolute URL of the Render backend, baked in at build time.
# NEXT_PUBLIC_API_URL=https://fraudies-api.onrender.com
