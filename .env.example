# Database (matches docker-compose postgres service)
DATABASE_URL="postgresql://postgres:password@localhost:5432/fraudies?schema=public"

# API
PORT=3001
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000
ML_ENGINE_URL=http://localhost:8000

# Webhook ingestion (POST /transactions/webhook) — send header X-Webhook-Secret: <this value>
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Dev workflow ---
# 1. Copy this file to .env and start Postgres (e.g. docker compose up -d)
# 2. Apply schema: npm run db:migrate:deploy   (or npm run db:migrate for local iteration)
# 3. ML service: cd apps/ml-engine && pip install -r requirements.txt  (use a venv)
# 4. Run stack: npm run dev:apps   (api + web + ml-engine)
# On Windows, if python is not on PATH, use py -m uvicorn ... from apps/ml-engine instead.
