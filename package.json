{
  "name": "fintech-fraudies",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "generate:data": "cd backend && python -m scripts.generate_dataset",
    "train": "cd backend && python -m scripts.train --force",
    "test:backend": "cd backend && python -m pytest -q",
    "install:frontend": "cd frontend && npm ci"
  },
  "engines": {
    "node": ">=20"
  }
}
